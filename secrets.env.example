# Скопируйте в secrets.env и заполните. Файл secrets.env в .gitignore.

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=your_telegram_bot_token_here
# Ваш Telegram user id (узнать можно у @userinfobot).
# Только этот пользователь может импортировать словарь.
MAIN_ADMIN_ID=123456789

# --- Время ---
TZ=Europe/Moscow

# --- PostgreSQL ---
# При запуске через docker compose POSTGRES_HOST/PORT переопределяются на postgres:5432.
# Для запуска бота с хоста порт 5433 — именно его пробрасывает контейнер,
# чтобы не конфликтовать с локально установленным postgres на 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=hebrewlearnbot
POSTGRES_USER=hebrewlearnbot
POSTGRES_PASSWORD=change_me

# --- Логи ---
LOG_LEVEL=Information
LOG_LEVEL_FILE=Information

# --- Квиз ---
# Сколько слов максимум грузить в пул для взвешенной выборки.
QUIZ_CANDIDATE_POOL_LIMIT=2000

# --- Импорт словаря ---
IMPORT_MAX_FILE_BYTES=1048576
IMPORT_MAX_ROWS=5000
